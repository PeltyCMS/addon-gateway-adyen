{
  "id": "gateway-adyen",
  "name": "Adyen-style redirect",
  "version": "0.1.0",
  "kind": "gateway",
  "engine": "wasm",
  "provides": "adyen",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.gateway.adyen",
  "author": "MythicalSystems",
  "permissions": [
    "payments.process",
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "checkout-test.adyen.com",
      "*.adyenpayments.com",
      "$setting:api_base"
    ],
    "secrets": [
      "api_key",
      "hmac_key"
    ]
  },
  "settings": []
}
